{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/invoice/:orderId",
      "destination": "https://semiskitchenbe.vercel.app/api/invoices/share/:orderId"
    },
    {
      "source": "/api/invoices/:path*",
      "destination": "https://semiskitchenbe.vercel.app/api/invoices/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
